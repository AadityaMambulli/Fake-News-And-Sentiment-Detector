# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=replace_with_a_random_secret_key

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fake_news_db

# Hugging Face Models
# Fake news model: zero-shot NLI classifier (no fine-tuning needed, FAKE/REAL labels are explicit)
FAKE_NEWS_MODEL=typeform/distilbert-base-uncased-mnli
# Sentiment model: sentiment analysis model
SENTIMENT_MODEL=distilbert/distilbert-base-uncased-finetuned-sst-2-english

# Frontend Origin for CORS
FRONTEND_URL=http://localhost:5173
